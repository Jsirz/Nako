{
  "id": "provider.official-text",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "type": "provider",
  "dependencies": {
    "generation-core": "^1.0.0"
  },
  "capabilities": [
    "generation.text"
  ],
  "services": {
    "requires": [
      "generation.providers"
    ],
    "provides": [
      "provider.GlmTextProvider",
      "provider.KimiTextProvider"
    ]
  },
  "credentials": [
    "provider.official-text"
  ],
  "providers": [
    {
      "name": "GlmTextProvider",
      "kinds": [
        "text"
      ],
      "execution": "immediate",
      "requiredSecrets": [
        "ZHIPU_API_KEY"
      ]
    },
    {
      "name": "KimiTextProvider",
      "kinds": [
        "text"
      ],
      "execution": "immediate",
      "requiredSecrets": [
        "MOONSHOT_API_KEY"
      ]
    }
  ]
}
