{
  "id": "provider.aliyun",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "type": "provider",
  "dependencies": {
    "generation-core": "^1.0.0"
  },
  "capabilities": [
    "generation.video"
  ],
  "services": {
    "requires": [
      "generation.providers"
    ],
    "provides": [
      "provider.AliyunVideoProvider"
    ]
  },
  "credentials": [
    "provider.aliyun"
  ],
  "providers": [
    {
      "name": "AliyunVideoProvider",
      "kinds": [
        "video"
      ],
      "execution": "polling",
      "requiredSecrets": [
        "ALIYUN_API_KEY"
      ]
    }
  ]
}
