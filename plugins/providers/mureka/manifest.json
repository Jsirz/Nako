{
  "id": "provider.mureka",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "type": "provider",
  "dependencies": {
    "generation-core": "^1.0.0"
  },
  "capabilities": [
    "generation.audio"
  ],
  "services": {
    "requires": [
      "generation.providers"
    ],
    "provides": [
      "provider.MurekaAudioProvider"
    ]
  },
  "credentials": [
    "provider.mureka"
  ],
  "providers": [
    {
      "name": "MurekaAudioProvider",
      "kinds": [
        "audio"
      ],
      "execution": "polling",
      "requiredSecrets": [
        "MUREKA_API_KEY"
      ]
    }
  ]
}
