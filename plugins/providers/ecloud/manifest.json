{
  "id": "provider.ecloud",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "type": "provider",
  "dependencies": { "generation-core": "^1.0.0" },
  "capabilities": ["generation.text", "generation.image", "generation.video", "generation.audio"],
  "services": {
    "requires": ["generation.providers"],
    "provides": [
      "provider.EcloudTextProvider",
      "provider.EcloudImageProvider",
      "provider.EcloudVideoProvider",
      "provider.EcloudAudioProvider"
    ]
  },
  "credentials": ["provider.ecloud"],
  "providers": [
    {
      "name": "EcloudTextProvider",
      "kinds": ["text"],
      "execution": "immediate",
      "requiredSecrets": ["ECLOUD_API_KEY"]
    },
    {
      "name": "EcloudImageProvider",
      "kinds": ["image"],
      "execution": "immediate",
      "requiredSecrets": ["ECLOUD_API_KEY"]
    },
    {
      "name": "EcloudVideoProvider",
      "kinds": ["video"],
      "execution": "polling",
      "requiredSecrets": ["ECLOUD_API_KEY"]
    },
    {
      "name": "EcloudAudioProvider",
      "kinds": ["audio"],
      "execution": "immediate",
      "requiredSecrets": ["ECLOUD_API_KEY"]
    }
  ]
}
