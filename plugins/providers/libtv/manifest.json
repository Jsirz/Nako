{
  "id": "provider.libtv",
  "contextKeys": [
    "LIBTV_CLI"
  ],
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "type": "provider",
  "dependencies": {
    "generation-core": "^1.0.0"
  },
  "capabilities": [
    "generation.image",
    "generation.video"
  ],
  "services": {
    "requires": [
      "generation.providers"
    ],
    "provides": [
      "provider.LibTvCliImageProvider",
      "provider.LibTvCliVideoProvider"
    ]
  },
  "credentials": [
    "provider.libtv"
  ],
  "providers": [
    {
      "name": "LibTvCliImageProvider",
      "kinds": [
        "image"
      ],
      "execution": "polling",
      "requiredSecrets": []
    },
    {
      "name": "LibTvCliVideoProvider",
      "kinds": [
        "video"
      ],
      "execution": "polling",
      "requiredSecrets": []
    }
  ]
}
