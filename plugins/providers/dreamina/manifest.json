{
  "id": "provider.dreamina",
  "contextKeys": [
    "DREAMINA_CLI"
  ],
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "type": "provider",
  "dependencies": {
    "generation-core": "^1.0.0"
  },
  "capabilities": [
    "generation.image",
    "generation.video"
  ],
  "services": {
    "requires": [
      "generation.providers",
      "generation.receipts"
    ],
    "provides": [
      "provider.DreaminaCliImageProvider",
      "provider.DreaminaCliVideoProvider"
    ]
  },
  "credentials": [
    "provider.dreamina"
  ],
  "providers": [
    {
      "name": "DreaminaCliImageProvider",
      "kinds": [
        "image"
      ],
      "execution": "polling",
      "requiredSecrets": []
    },
    {
      "name": "DreaminaCliVideoProvider",
      "kinds": [
        "video"
      ],
      "execution": "polling",
      "requiredSecrets": []
    }
  ]
}
