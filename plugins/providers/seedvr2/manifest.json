{
  "id": "provider.seedvr2",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "type": "provider",
  "dependencies": {
    "generation-core": "^1.0.0",
    "workflow.runninghub-webapp": "^1.0.0"
  },
  "capabilities": [
    "generation.image"
  ],
  "services": {
    "requires": [
      "generation.providers",
      "generation.receipts",
      "workflow.executors",
      "workflow.support",
      "platform.paths"
    ],
    "provides": [
      "provider.SeedVr2ImageProvider"
    ]
  },
  "credentials": [
    "provider.seedvr2"
  ],
  "providers": [
    {
      "name": "SeedVr2ImageProvider",
      "kinds": [
        "image"
      ],
      "execution": "polling",
      "requiredSecrets": [
        "RUNNINGHUB_API_KEY"
      ]
    }
  ]
}
