{
  "id": "provider.work-fisher",
  "version": "1.0.0",
  "apiVersion": "^1.0.0",
  "type": "provider",
  "dependencies": {
    "generation-core": "^1.0.0",
    "module.media-capabilities": "^1.0.0"
  },
  "capabilities": [
    "generation.text",
    "generation.image",
    "generation.video",
    "generation.audio"
  ],
  "services": {
    "requires": [
      "generation.providers",
      "generation.receipts",
      "media.runtime"
    ],
    "provides": [
      "provider.WorkFisherTextProvider",
      "provider.WorkFisherImageProvider",
      "provider.WorkFisherVideoProvider",
      "provider.WorkFisherAudioProvider"
    ]
  },
  "credentials": [
    "provider.work-fisher"
  ],
  "providers": [
    {
      "name": "WorkFisherTextProvider",
      "kinds": [
        "text"
      ],
      "execution": "immediate",
      "requiredSecrets": [
        "WORK_FISHER_API_KEY"
      ]
    },
    {
      "name": "WorkFisherImageProvider",
      "kinds": [
        "image"
      ],
      "execution": "polling",
      "requiredSecrets": [
        "WORK_FISHER_API_KEY"
      ]
    },
    {
      "name": "WorkFisherVideoProvider",
      "kinds": [
        "video"
      ],
      "execution": "polling",
      "requiredSecrets": [
        "WORK_FISHER_API_KEY"
      ]
    },
    {
      "name": "WorkFisherAudioProvider",
      "kinds": [
        "audio"
      ],
      "execution": "polling",
      "requiredSecrets": [
        "WORK_FISHER_API_KEY"
      ]
    }
  ]
}
