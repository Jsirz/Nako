{
  "id": "shot-analysis",
  "version": "1.0.0",
  "apiVersion": "^2.0.0",
  "title": "拉片与复刻示例",
  "entry": "index.mjs",
  "capabilities": [
    "media.inspect",
    "models.generate"
  ],
  "nodes": [
    {
      "type": "shot-analysis.analyze",
      "version": "1.0.0",
      "category": "tool",
      "title": "视频拉片",
      "description": "抽取当前项目视频的关键帧，使用默认视觉文本模型生成镜头分析。",
      "inputs": [
        {
          "id": "video",
          "media": [
            "video"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "id": "analysis",
          "media": [
            "text"
          ],
          "required": true
        },
        {
          "id": "frames",
          "media": [
            "json"
          ],
          "required": true
        }
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "title": "分析要求",
            "default": "分析镜头构图、运镜、光线、人物动作和剪辑节奏，为每个镜头提供中文复刻提示词。"
          },
          "textModel": {
            "type": "string",
            "title": "文本模型（空值使用默认）",
            "default": ""
          }
        }
      },
      "render": {
        "kind": "iframe",
        "entry": "ui.html"
      },
      "executor": {
        "method": "analyze",
        "transport": "rpc",
        "timeoutMs": 600000
      },
      "agent": {
        "exposed": true,
        "description": "视频关键帧与镜头分析，结果提供后续图像或视频生成节点使用。",
        "sideEffect": "network",
        "requiresConfirmation": true
      }
    },
    {
      "type": "shot-analysis.recreate",
      "version": "1.0.0",
      "category": "generation",
      "title": "镜头复刻示例",
      "description": "分析视频后生成参考图，再生成一个新视频。本节点最多调用三个模型；执行前由宿主确认。",
      "inputs": [
        {
          "id": "video",
          "media": [
            "video"
          ],
          "required": true
        }
      ],
      "outputs": [
        {
          "id": "analysis",
          "media": [
            "text"
          ],
          "required": true
        },
        {
          "id": "image",
          "media": [
            "image"
          ],
          "required": true
        },
        {
          "id": "video",
          "media": [
            "video"
          ],
          "required": true
        }
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "title": "创作要求",
            "default": "保留运镜与构图节奏，重新创作角色和场景，输出一个可直接生成视频的中文提示词。"
          },
          "textModel": {
            "type": "string",
            "default": "",
            "title": "视觉文本模型"
          },
          "imageModel": {
            "type": "string",
            "default": "",
            "title": "图像模型"
          },
          "videoModel": {
            "type": "string",
            "default": "",
            "title": "视频模型"
          }
        }
      },
      "render": {
        "kind": "generic"
      },
      "executor": {
        "method": "recreate",
        "transport": "rpc",
        "timeoutMs": 1800000
      },
      "agent": {
        "exposed": true,
        "sideEffect": "network",
        "requiresConfirmation": true
      }
    }
  ]
}
